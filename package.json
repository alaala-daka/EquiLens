{
  "name": "equilens",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node scripts/build-docx-validator.mjs && node scripts/build-retention-tools.mjs && next dev",
    "build": "node scripts/build-docx-validator.mjs && node scripts/build-retention-tools.mjs && next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "test": "node scripts/build-docx-validator.mjs && node scripts/build-retention-tools.mjs && tsx --test src/lib/documents/*.test.ts src/server/database/*.test.ts src/server/auth/*.test.ts src/server/documents/*.test.ts src/server/ai/*.test.ts src/server/contract-review/tasks/*.test.ts tools/contract-review/tests/*.test.ts",
    "prepare:contract": "node scripts/build-docx-validator.mjs",
    "test:contract": "pnpm prepare:contract && tsx --test tools/contract-review/tests/*.test.ts",
    "review:contract": "pnpm prepare:contract && tsx tools/contract-review/src/cli.ts",
    "review:contract:example": "tsx tools/contract-review/examples/local.mts",
    "review:contract:agent": "node scripts/build-docx-validator.mjs && tsx tools/contract-review/src/cli.ts --agent",
    "ai:smoke": "tsx scripts/check-model.mts",
    "account:maintain": "tsx scripts/manage-account.mts",
    "fixtures:structures": "tsx scripts/docx-structure-fixtures.mts",
    "roundtrip:engine": "tsx scripts/roundtrip/engine-roundtrip.mts",
    "roundtrip:word": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/roundtrip/verify-word.ps1",
    "roundtrip": "pnpm fixtures:structures && pnpm roundtrip:engine && pnpm roundtrip:word",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.75",
    "ai": "7.0.148",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "gaussdb-node": "0.2.2",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.8",
    "server-only": "0.0.1",
    "shadcn": "^4.22.1",
    "superdoc": "1.47.2",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "6.2.6",
    "playwright-core": "1.64.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": "11.6.0"
  }
}
