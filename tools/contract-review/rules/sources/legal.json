[
  {
    "sourceId": "LAW-CivilCode-509",
    "type": "法律依据",
    "name": "《中华人民共和国民法典》",
    "article": "第五百零九条",
    "text": "当事人应当按照约定全面履行自己的义务。当事人应当遵循诚信原则，根据合同的性质、目的和交易习惯履行通知、协助、保密等义务。当事人在履行合同过程中，应当避免浪费资源、污染环境和破坏生态。",
    "issuer": "全国人民代表大会",
    "effectiveDate": "2021-01-01",
    "region": "中国",
    "status": "待核对",
    "reviewer": null,
    "reviewedAt": null,
    "officialUrl": "https://www.court.gov.cn/zixun/xiangqing/233181.html"
  },
  {
    "sourceId": "LAW-CivilCode-577",
    "type": "法律依据",
    "name": "《中华人民共和国民法典》",
    "article": "第五百七十七条",
    "text": "当事人一方不履行合同义务或者履行合同义务不符合约定的，应当承担继续履行、采取补救措施或者赔偿损失等违约责任。",
    "issuer": "全国人民代表大会",
    "effectiveDate": "2021-01-01",
    "region": "中国",
    "status": "待核对",
    "reviewer": null,
    "reviewedAt": null,
    "officialUrl": "https://www.court.gov.cn/zixun/xiangqing/233181.html"
  },
  {
    "sourceId": "LAW-CivilCode-585",
    "type": "法律依据",
    "name": "《中华人民共和国民法典》",
    "article": "第五百八十五条",
    "text": "当事人可以约定一方违约时应当根据违约情况向对方支付一定数额的违约金，也可以约定因违约产生的损失赔偿额的计算方法。约定的违约金低于造成的损失的，人民法院或者仲裁机构可以根据当事人的请求予以增加；约定的违约金过分高于造成的损失的，人民法院或者仲裁机构可以根据当事人的请求予以适当减少。",
    "issuer": "全国人民代表大会",
    "effectiveDate": "2021-01-01",
    "region": "中国",
    "status": "待核对",
    "reviewer": null,
    "reviewedAt": null,
    "officialUrl": "https://www.court.gov.cn/zixun/xiangqing/233181.html"
  },
  {
    "sourceId": "LAW-CivilCode-788",
    "type": "法律依据",
    "name": "《中华人民共和国民法典》",
    "article": "第七百八十八条",
    "text": "建设工程合同是承包人进行工程建设，发包人支付价款的合同。建设工程合同包括工程勘察、设计、施工合同。",
    "issuer": "全国人民代表大会",
    "effectiveDate": "2021-01-01",
    "region": "中国",
    "status": "待核对",
    "reviewer": null,
    "reviewedAt": null,
    "officialUrl": "https://www.court.gov.cn/zixun/xiangqing/233181.html"
  },
  {
    "sourceId": "LAW-CivilCode-793",
    "type": "法律依据",
    "name": "《中华人民共和国民法典》",
    "article": "第七百九十三条",
    "text": "建设工程施工合同无效，但是建设工程经验收合格的，可以参照合同关于工程价款的约定折价补偿承包人。",
    "issuer": "全国人民代表大会",
    "effectiveDate": "2021-01-01",
    "region": "中国",
    "status": "待核对",
    "reviewer": null,
    "reviewedAt": null,
    "officialUrl": "https://www.court.gov.cn/zixun/xiangqing/233181.html"
  },
  {
    "sourceId": "LAW-CivilCode-803",
    "type": "法律依据",
    "name": "《中华人民共和国民法典》",
    "article": "第八百零三条",
    "text": "发包人未按照约定的时间和要求提供原材料、设备、场地、资金、技术资料的，承包人可以顺延工程日期，并有权请求赔偿停工、窝工等损失。",
    "issuer": "全国人民代表大会",
    "effectiveDate": "2021-01-01",
    "region": "中国",
    "status": "待核对",
    "reviewer": null,
    "reviewedAt": null,
    "officialUrl": "https://www.court.gov.cn/zixun/xiangqing/233181.html"
  },
  {
    "sourceId": "LAW-CivilCode-804",
    "type": "法律依据",
    "name": "《中华人民共和国民法典》",
    "article": "第八百零四条",
    "text": "因发包人的原因致使工程中途停建、缓建的，发包人应当采取措施弥补或者减少损失，赔偿承包人因此造成的停工、窝工、倒运、机械设备调迁、材料和构件积压等损失和实际费用。",
    "issuer": "全国人民代表大会",
    "effectiveDate": "2021-01-01",
    "region": "中国",
    "status": "待核对",
    "reviewer": null,
    "reviewedAt": null,
    "officialUrl": "https://www.court.gov.cn/zixun/xiangqing/233181.html"
  },
  {
    "sourceId": "LAW-CivilCode-806",
    "type": "法律依据",
    "name": "《中华人民共和国民法典》",
    "article": "第八百零六条",
    "text": "承包人将建设工程转包、违法分包的，发包人可以解除合同。\n发包人提供的主要建筑材料、建筑构配件和设备不符合强制性标准或者不履行协助义务，致使承包人无法施工，经催告后在合理期限内仍未履行相应义务的，承包人可以解除合同。\n合同解除后，已经完成的建设工程质量合格的，发包人应当按照约定支付相应的工程价款；已经完成的建设工程质量不合格的，参照本法第七百九十三条的规定处理。",
    "issuer": "全国人民代表大会",
    "effectiveDate": "2021-01-01",
    "region": "中国",
    "status": "待核对",
    "reviewer": null,
    "reviewedAt": null,
    "officialUrl": "https://www.court.gov.cn/zixun/xiangqing/233181.html"
  }
]
