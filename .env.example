DATABASE_PROVIDER=sqlite
SQLITE_PATH=data/equilens.sqlite
# Optional model connection. ai:smoke sends one fixed synthetic message.
AI_BASE_URL=https://aigw.saurlax.com/v1
AI_MODEL=glm-5.3-flash
AI_API_KEY=
# Required before published-mode review: set only after validating the model's
# complete prompt (contract + rules + source text + tool schemas/history)
# and reserved output budget. Agent caps the serialized request, not only new text.
# Debug mode uses a provisional 24000-character prompt cap.
# AI_REVIEW_MAX_PROMPT_CHARS=24000
# AI SDK Agent only: provisional total request cap, including skill selection,
# reading and submissions. Backend accepts 1-16; no SDK automatic retries.
# AI_AGENT_MAX_CALLS=8
# Web task mode is fixed by the server, never supplied by the browser.
# Development defaults to debug; production defaults to published.
# AI_REVIEW_MODE=debug
# Web review-task retention: development defaults to 7 days; production must set 1-365.
# AI_REVIEW_RETENTION_DAYS=7
# Remote deployment only: the exact public origin, without a trailing slash.
# APP_ORIGIN=https://equilens.zeabur.app
# SOURCE_COMMIT=<full 40-character deployed Git commit>

# Set DATABASE_PROVIDER=gaussdb to use a separately provisioned GaussDB instance.
# GAUSSDB_HOST=
# GAUSSDB_PORT=8000
# GAUSSDB_DATABASE=
# GAUSSDB_USER=
# GAUSSDB_PASSWORD=
# GAUSSDB_CA_PATH=/run/secrets/gaussdb-ca.pem
