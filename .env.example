DATABASE_PROVIDER=sqlite
SQLITE_PATH=data/equilens.sqlite
# Required for anonymous document creation; register the purpose, duration and legacy export window.
ANONYMOUS_DATA_RETENTION_DAYS=
# SQLite defaults to retention-journal beside the database; required explicitly for GaussDB.
# ANONYMOUS_DELETION_JOURNAL_DIR=/data/equilens/retention-journal
# Optional, separately registered positive integer; omit to retain unused empty session rows.
# An explicitly empty or invalid value fails data readiness. No default.
# ANONYMOUS_EMPTY_SESSION_RETENTION_DAYS=<registered positive integer>
# Remote deployment only: the exact public origin, without a trailing slash.
# APP_ORIGIN=https://equilens.zeabur.app
# SOURCE_COMMIT=<full 40-character deployed Git commit>

# Set DATABASE_PROVIDER=gaussdb to use a separately provisioned GaussDB instance.
# GAUSSDB_HOST=
# GAUSSDB_PORT=8000
# GAUSSDB_DATABASE=
# GAUSSDB_USER=
# GAUSSDB_PASSWORD=
# GAUSSDB_CA_PATH=/run/secrets/gaussdb-ca.pem

# Optional model connection; keys stay server-side. ai:smoke sends a synthetic message.
AI_BASE_URL=https://aigw.saurlax.com/v1
AI_MODEL=glm-5.3-flash
AI_API_KEY=
# Published mode requires a verified model-specific prompt budget (1000-240000 chars).
# AI_REVIEW_MAX_PROMPT_CHARS=240000
# Total requests across recovery/retries; 1-40, default 25.
# AI_AGENT_MAX_CALLS=25
# Development defaults to debug; production defaults to published.
# Built-in unreviewed rules are usable only in explicitly confirmed debug mode.
# AI_REVIEW_MODE=debug
# Production requires 1-365 days. Source-session expiry takes precedence.
# AI_REVIEW_RETENTION_DAYS=7
# AI_AUDIT_REASONING_EFFORT=default
# Use low only with a model provider that supports reasoning_effort=low.
