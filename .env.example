DATABASE_PROVIDER=sqlite
SQLITE_PATH=data/equilens.sqlite
# Optional model connection. ai:smoke sends one fixed synthetic message.
AI_BASE_URL=https://aigw.saurlax.com/v1
AI_MODEL=glm-5.3-flash
AI_API_KEY=
# Required before published-mode review. Validated basis: the configured model
# provides a 1,000,000-token context. The cap counts characters of the serialized
# request (contract + rules + source text + tool schemas + replayed history), so
# 240000 Chinese characters sit near 24% of the window and leave room for the
# 8192-token output reserve. Debug mode defaults to the same validated cap and the
# server rejects values above 240000.
# AI_REVIEW_MAX_PROMPT_CHARS=240000
# AI SDK Agent only: total request cap, including skill selection, reading and
# submissions. Measured: a 69-paragraph contract consumes 12 calls at 8 paragraphs
# each, so the default sits at the backend maximum of 25 to keep headroom. The value
# is a ceiling, not a target: the loop stops when findings are submitted. Each call
# re-sends the whole request, so only contracts that need the extra turns cost more.
# AI_AGENT_MAX_CALLS=25
# Web task mode is fixed by the server, never supplied by the browser.
# Development defaults to debug; production defaults to published.
# AI_REVIEW_MODE=debug
# Web review-task retention: development defaults to 7 days; production must set 1-365.
# AI_REVIEW_RETENTION_DAYS=7
# Remote deployment only: the exact public origin, without a trailing slash.
# APP_ORIGIN=https://equilens.zeabur.app
# SOURCE_COMMIT=<full 40-character deployed Git commit>

# Set DATABASE_PROVIDER=gaussdb to use a separately provisioned GaussDB instance.
# GAUSSDB_HOST=
# GAUSSDB_PORT=8000
# GAUSSDB_DATABASE=
# GAUSSDB_USER=
# GAUSSDB_PASSWORD=
# GAUSSDB_CA_PATH=/run/secrets/gaussdb-ca.pem
